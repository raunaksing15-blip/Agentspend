
# Local API runs in simulation mode only.
EXECUTION_MODE=SIMULATED
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Set unique random values locally. Never commit real values.
AGENT_API_TOKEN=replace-with-a-long-random-secret
AGENT_ACCOUNT_ID=agent-a.test.near
OWNER_API_TOKEN=replace-with-a-different-long-random-secret

# TESTNET mode is intentionally unavailable until a real ChainPort adapter
# is implemented, reviewed, and configured.
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=
